# aOS environment variables.
# Copy this file to .env.local and fill in the real values. Never commit .env.local.
#
# Supabase → your aos-portal project → Settings (gear) → API

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon public" key. Safe to expose to the browser — RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. Bypasses RLS entirely. Server-side only, never prefixed
# NEXT_PUBLIC_, never pasted anywhere that reaches the browser or git.
SUPABASE_SERVICE_ROLE_KEY=

# This app's own public origin — http://localhost:3000 locally,
# https://aos.allegrostrategia.com in production. Used to build the links in
# Supabase's invitation and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product email (reminders). Separate from the Resend credentials in Supabase's
# SMTP settings, which send auth email — same provider and domain, two places.
RESEND_API_KEY=
EMAIL_FROM="aOS <noreply@allegrostrategia.com>"

# Shared secret for the daily cron. Vercel sends it as a bearer token; the
# endpoint refuses to run without it.
CRON_SECRET=
